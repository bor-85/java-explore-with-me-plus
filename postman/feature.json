    {
      "name": "Add comment",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status code is 201\", () => pm.response.to.have.status(201));",
              "const c = pm.response.json();",
              "pm.test(\"Comment has correct fields\", () => {",
              "    pm.expect(c.id).to.be.a(\"number\");",
              "    pm.expect(c.text).to.eql(\"Great event!\");",
              "    pm.expect(c.eventId).to.eql(Number(pm.collectionVariables.get(\"eventId\")));",
              "    pm.expect(c.author.id).to.eql(Number(pm.collectionVariables.get(\"userId\")));",
              "    pm.expect(c.created).to.be.a(\"string\");",
              "    pm.expect(c.updated).to.be.null;",
              "});",
              "pm.collectionVariables.set(\"commentId\", c.id);"
            ]
          }
        }
      ],
